// m0_02: Integer arithmetic operators (+, -, *, /, %)
int main() {
    int a = 10;
    int b = 3;
    int sum = a + b;     // 13
    int diff = a - b;    // 7
    int prod = a * b;    // 30
    int div = a / b;     // 3
    int mod_op = a % b;     // 1
    return sum + diff + prod + div + mod_op;
}

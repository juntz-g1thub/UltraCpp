# Rust
target/
Cargo.lock
**/*.rs.o
**/*.rs.bk
*.pdb
!.cargo/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# OS
.DS_Store
Thumbs.db
*.bak

# Build outputs
build/
*.o
*.s
*.ll
*.asm
# Exception: bootstrap/baseline/ files are reference outputs, not build artifacts
!bootstrap/baseline/*.ll
!bootstrap/baseline/*.s

# C port (src-c/) build artifacts
src-c/build/

# Test outputs
*.exe
test_local
test_extern
test_import
test_hello
/tmp/

# UltraCPP specific
*.uc.bak
*.upp.bak

# Agent working files
.sisyphus/run-continuation/

# Git worktrees (isolated feature workspaces)
.worktrees/

# Misc
*.log
*.tmp

# pi coding agent session exports (HTML session logs)
# Filename shape: pi-session-<ISO-UTC-timestamp>Z_<UUID>.html
# The `Z_` anchor is the UTC timestamp marker followed by the underscore
# separator before the UUID, which uniquely identifies this file family.
pi-session-*Z_*.html

# MCP / agent tool caches (do not track runtime artifacts)
.serena/

# M0 baseline test results (generated by test/e2e/run_baseline.sh)
# Each run overwrites test/results/m0_baseline.txt with current pass/fail
# counts; treat as a build artifact, never as tracked source.
test/results/

# pi agent scratch (per 0.3.6 plan D11)
# Created at runtime by pi-agent sessions for tool-cache and session notes;
# never check into git.
.pi/
